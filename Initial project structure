int main() {
    vector<Student> students;
    int choice;
    
    do {
        cout << "\n=== DIGITAL ATTENDANCE SYSTEM ===" << endl;
        cout << "1. Add Student" << endl;
        cout << "2. View All Students" << endl;
        cout << "3. Search Student" << endl;  // NEW
        cout << "4. Exit" << endl;             // CHANGED
        cout << "Choice: ";
        cin >> choice;
        
        switch(choice) {
            case 1: {
                // ... same as before ...
                break;
            }
            case 2: {
                // ... same as before ...
                break;
            }
            case 3: {  // NEW SEARCH FUNCTION
                if(students.empty()) {
                    cout << "No students yet." << endl;
                } else {
                    string searchIdx;
                    cout << "Enter Index Number to search: ";
                    cin >> searchIdx;
                    
                    bool found = false;
                    for(int i = 0; i < students.size(); i++) {
                        if(students[i].getIndexNumber() == searchIdx) {
                            cout << "\nSTUDENT FOUND:" << endl;
                            students[i].display();
                            found = true;
                            break;
                        }
                    }
                    if(!found) {
                        cout << "Student not found!" << endl;
                    }
                }
                break;
            }
            case 4:
                cout << "Exiting..." << endl;
                break;
            default:
                cout << "Invalid choice!" << endl;
        }
    } while(choice != 4);
    
    return 0;
}
