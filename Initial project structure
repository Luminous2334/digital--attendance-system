int main() {
    vector<Student> students;
    int choice;
    
    do {
        cout << "\n=== DIGITAL ATTENDANCE SYSTEM ===" << endl;
        cout << "1. Add Student" << endl;
        cout << "2. View All Students" << endl;
        cout << "3. Exit" << endl;
        cout << "Choice: ";
        cin >> choice;
        
        switch(choice) {
            case 1: {
                string idx, name, dept;
                int level;
                
                cout << "Enter Index Number: ";
                cin >> idx;
                cin.ignore();
                cout << "Enter Name: ";
                getline(cin, name);
                cout << "Enter Department: ";
                getline(cin, dept);
                cout << "Enter Level: ";
                cin >> level;
                
                students.push_back(Student(idx, name, dept, level));
                cout << "Student Added!" << endl;
                break;
            }
            case 2: {
                if(students.empty()) {
                    cout << "No students yet." << endl;
                } else {
                    cout << "\nSTUDENT LIST:" << endl;
                    for(int i = 0; i < students.size(); i++) {
                        students[i].display();
                    }
                }
                break;
            }
            case 3:
                cout << "Exiting..." << endl;
                break;
            default:
                cout << "Invalid choice!" << endl;
        }
    } while(choice != 3);
    
    return 0;
}
